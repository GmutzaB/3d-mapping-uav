# Starts the LiDAR, MAVROS and obstacle node at boot.
# Edit User and the paths if the repo isn't at /home/ubuntu/3d-mapping-uav.
#
#   sudo cp uav-ros.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now uav-ros
#   journalctl -u uav-ros -f        # view output

[Unit]
Description=UAV LiDAR + MAVROS (ROS 2 Jazzy)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
ExecStart=/bin/bash -c 'if [[ -f /opt/ros/lyrical/setup.bash ]]; then source /opt/ros/lyrical/setup.bash; else source /opt/ros/jazzy/setup.bash; fi && source /home/ubuntu/3d-mapping-uav/ros2_ws/install/setup.bash && exec ros2 launch uav_lidar_bridge uav.launch.py'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
